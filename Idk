-- === PRIVÁTNÍ BOT (POUZE EXECUTE) ===
local function botReply(message)
	if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
		local channel = TextChatService:FindFirstChild("RBXGeneral", true)
		if channel then channel:DisplaySystemMessage("<font color='#00E5FF'><b>[Bot]:</b></font> " .. message) end
	else
		game:GetService("StarterGui"):SetCore("ChatMakeSystemMessage", {Text = "[Bot]: "..message; Color = Color3.fromRGB(0, 229, 255); Font = Enum.Font.GothamBold;})
	end
end

