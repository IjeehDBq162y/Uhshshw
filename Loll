-- Anti-Blackhole: Prevent blackhole/gravity exploits  
local function antiBlackhole()  
    local function onCharacterAdded(character)  
        local rootPart = character:WaitForChild("HumanoidRootPart")  
        if rootPart then  
            local connection  
            connection = RunService.Heartbeat:Connect(function()  
                if not CONFIG.Enabled or not rootPart or not rootPart.Parent then  
                    if connection then connection:Disconnect() end  
                    return  
                end  
                  
                -- Monitor for abnormal gravitational forces  
                if rootPart.AssemblyLinearVelocity.Magnitude > 500 then  
                    -- Extremely high velocity, likely a blackhole effect  
                    rootPart.AssemblyLinearVelocity = rootPart.AssemblyLinearVelocity * 0.1  
                end  
                  
                -- Prevent being pulled to a point (blackhole)  
                for _, obj in pairs(workspace:GetDescendants()) do  
                    if obj:IsA("BasePart") and obj.Name:lower():find("blackhole") then  
                        -- Destroy blackhole parts  
                        if CONFIG.Enabled then  
                            obj:Destroy()  
                        end  
                    end  
                    -- Also check for parts with extreme properties (blackhole simulation)  
                    if obj:IsA("Part") or obj:IsA("MeshPart") or obj:IsA("UnionOperation") then  
                        if obj:GetAttribute("Blackhole") or obj:GetAttribute("GravityWell") then  
                            if CONFIG.Enabled then  
                                obj:Destroy()  
                            end  
                        end  
                    end  
                end  
            end)  
        end  
    end  
      
    if player.Character then  
        onCharacterAdded(player.Character)  
    end  
    player.CharacterAdded:Connect(onCharacterAdded)  
end

