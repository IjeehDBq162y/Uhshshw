        local humanoid = character:WaitForChild("Humanoid")  
          
        humanoid.Died:Connect(function()  
            if CONFIG.Enabled then  
                -- Check if death was caused by a tool exploit  
                task.wait(0.5)  
                -- Attempt to respawn  
                if player.Character then return end -- Already respawned  
                -- Respawn logic handled by game  
            end  
        end)  
          
        -- Remove damage sources from tools  
        character.DescendantAdded:Connect(function(descendant)  
            if not CONFIG.Enabled then return end  
