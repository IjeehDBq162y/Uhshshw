-- Anti-Fling: Prevent character from being flung  
local function antiFling()  
    local function onCharacterAdded(character)  
        local humanoid = character:WaitForChild("Humanoid")  
        local rootPart = character:WaitForChild("HumanoidRootPart")  
          
        if rootPart then  
            -- Remove any existing linear velocity constraints  
            for _, child in pairs(character:GetDescendants()) do  
                if child:IsA("BodyVelocity") or child:IsA("BodyAngularVelocity") then  
                    child:Destroy()  
                end  
            end  
              
            -- Prevent flinging by anchoring root part temporarily when force is applied  
            rootPart.Anchored = false  
              
            -- Use Heartbeat to reset unwanted velocities  
            local connection  
            connection = RunService.Heartbeat:Connect(function()  
                if not CONFIG.Enabled or not rootPart or not rootPart.Parent then  
                    if connection then connection:Disconnect() end  
                    return  
                end  
                  
                -- Reset linear and angular velocity to prevent flinging  
                rootPart.Velocity = Vector3.new(0, 0, 0)  
                rootPart.RotVelocity = Vector3.new(0, 0, 0)  
                rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)  
                rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)  
            end)  
              
            character.DescendantAdded:Connect(function(descendant)  
                if descendant:IsA("BodyVelocity") or descendant:IsA("BodyAngularVelocity") then  
                    descendant:Destroy()  
                end  
            end)  
        end  
    end  
      
    if player.Character then  
        onCharacterAdded(player.Character)  
    end  
    player.CharacterAdded:Connect(onCharacterAdded)  
end

-- Anti-Ring: Anti-exploit ring tools  
local function antiRing()  
    local function onCharacterAdded(character)  
        character.DescendantAdded:Connect(function(descendant)  
            if not CONFIG.Enabled then return end  
            if descendant:IsA("Tool") then  
                -- Monitor tools that might create ring-like exploitations  
                for _, child in pairs(descendant:GetDescendants()) do  
                    if child:IsA("BodyVelocity") or child:IsA("BodyAngularVelocity") then  
                        if CONFIG.Enabled then  
                            child:Destroy()  
                        end  
                    end  
                end  
            end  
        end)  
    end  
      
    if player.Character then  
        onCharacterAdded(player.Character)  
    end  
    player.CharacterAdded:Connect(onCharacterAdded)  
end

